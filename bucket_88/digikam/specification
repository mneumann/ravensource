NAMEBASE=		digikam
VERSION=		${PORTVERSION}
KEYWORDS=		graphics
VARIANTS=		std
SDESC[std]=		KDE digital photo management application
HOMEPAGE=		https://www.digikam.org/
CONTACT=		Michael_Neumann[mneumann@ntecs.de]

DOWNLOAD_GROUPS=	main
SITES[main]=		https://download.kde.org/stable/digikam/${PORTVERSION}/
DISTFILE[1]=		digiKam-${PORTVERSION}.tar.xz:main

SPKGS[std]=		set primary docs nls

OPTIONS_AVAILABLE=	none
OPTIONS_STANDARD=	none

LICENSE=		GPLv2+:primary
