From e4a7cf99bfe81cc8627e753be8c38b298cfc40c9 Mon Sep 17 00:00:00 2001
From: Michael Neumann <mneumann@ntecs.de>
Date: Tue, 5 Aug 2025 17:14:46 +0200
Subject: [PATCH] xorg-server: Re-enable glamor hw accel, disabled by default

Taken-from: DPorts [1]

[1]: https://github.com/DragonFlyBSD/DeltaPorts/pull/1503/commits/d46cb049a86396a36d76a7c533e051073a74e9b8
---
 .../patches/patch-hw_xfree86_drivers_modesetting_driver.c   | 6 +-----
 bucket_E7/xorg-server/specification                         | 1 +
 2 files changed, 2 insertions(+), 5 deletions(-)

diff --git a/bucket_E7/xorg-server/patches/patch-hw_xfree86_drivers_modesetting_driver.c b/bucket_E7/xorg-server/patches/patch-hw_xfree86_drivers_modesetting_driver.c
index 17e4392be2..3890a85e2d 100644
--- a/bucket_E7/xorg-server/patches/patch-hw_xfree86_drivers_modesetting_driver.c
+++ b/bucket_E7/xorg-server/patches/patch-hw_xfree86_drivers_modesetting_driver.c
@@ -4,12 +4,8 @@
      modesettingPtr ms = modesettingPTR(pScrn);
      const char *accel_method_str = xf86GetOptValString(ms->drmmode.Options,
                                                         OPTION_ACCEL_METHOD);
-+#if defined(__DragonFly__)
-+    Bool do_glamor = FALSE;
-+#else
-     Bool do_glamor = (!accel_method_str ||
+     Bool do_glamor = (accel_method_str &&
                        strcmp(accel_method_str, "glamor") == 0);
-+#endif
  
      ms->drmmode.glamor = FALSE;
  
diff --git a/bucket_E7/xorg-server/specification b/bucket_E7/xorg-server/specification
index f178f0ae4e..928b67501d 100644
--- a/bucket_E7/xorg-server/specification
+++ b/bucket_E7/xorg-server/specification
@@ -3,6 +3,7 @@ DEF[PORTVERSION]=	21.1.18
 
 NAMEBASE=		xorg-server
 VERSION=		${PORTVERSION}
+REVISINON=		1
 KEYWORDS=		x11_servers
 VARIANTS=		std virtual xephyr nest
 SDESC[std]=		X.Org X server and related programs
-- 
2.50.1

